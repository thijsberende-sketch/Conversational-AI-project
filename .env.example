# Copy this file to .env and fill in the values.

# IP address of the Furhat robot (shown on the robot's web interface)
FURHAT_HOST=localhost

# Which LLM writes the questions: "openai" (class API key, default) or "openrouter" (free models)
LLM_PROVIDER=openrouter

# OpenAI: used when LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# OpenRouter: used when LLM_PROVIDER=openrouter, key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: model IDs ending in ":free", comma-separated. The first is used; the others take over when it
# is rate limited or down, which happens a lot with free models. "openrouter/free" also works but picks a
# random free model each request, often a slow reasoning model (20+ seconds per question).
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free,nvidia/nemotron-3.5-super-vl:free,google/gemma-4-26b-a4b-it:free

